# ═══ 识海面板 nginx 配置示例 ═══
# 放置：/etc/nginx/conf.d/ 里你的 TLS server{} 内（或 include）
# 前提：certbot 签好 TLS；htpasswd 已生成（见文件尾注释）

# （放在 http 上下文 —— conf.d/*.conf 默认就是 http 上下文，直接放文件顶部）
limit_req_zone $binary_remote_addr zone=shihai:1m rate=6r/m;

# server{} 里：
location ^~ /shihai-CHANGE-ME/ {              # ← 换成长随机路径（安全第一层）
    alias /opt/shihai/;                        # ← index.html 与 data/ 所在目录
    index index.html;
    auth_basic "Shihai";
    auth_basic_user_file /etc/nginx/.htpasswd-shihai;
    limit_req zone=shihai burst=4 nodelay;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'self'" always;
}

# 生成 BasicAuth 密码文件（需要 openssl）：
#   printf "yourname:$(openssl passwd -apr1 '你的强密码')\n" | sudo tee /etc/nginx/.htpasswd-shihai
#   sudo chmod 640 /etc/nginx/.htpasswd-shihai && sudo chown root:$(nginx 的组)/etc/nginx/.htpasswd-shihai
# 别忘了：sudo nginx -t && sudo systemctl reload nginx
